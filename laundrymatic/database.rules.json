{
  "rules": {
    "shops": {
      "$shopId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).child('shopId').val() === $shopId)"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "users": {
    ".indexOn": ["status"],
    ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
    "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
     }
    },

"orders": {
  ".indexOn": ["shopId", "userId"],
  ".read": "auth != null && ((root.child('admins').child(auth.uid).exists() && query.orderByChild === 'shopId' && query.equalTo === root.child('admins').child(auth.uid).child('shopId').val()) || (root.child('admins').child(auth.uid).exists() && query.orderByChild === 'userId') || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
  "$orderId": {
    ".read": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || (root.child('admins').child(auth.uid).exists() && root.child('admins').child(auth.uid).child('shopId').val() === data.child('shopId').val()))",
    ".write": "auth != null && root.child('admins').child(auth.uid).exists() && root.child('admins').child(auth.uid).child('shopId').val() === newData.child('shopId').val()"
  }
},

    "notifications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "settings": {
      "$shopId": {
        ".read": "auth != null && root.child('admins').child(auth.uid).child('shopId').val() === $shopId",
        ".write": "auth != null && root.child('admins').child(auth.uid).child('shopId').val() === $shopId"
      }
    },

    "liveWeight": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "weightHistory": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    }
  }
}